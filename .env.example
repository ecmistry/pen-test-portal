# PenTest Portal — Environment Variables
# Copy to .env and fill in values

# Required for session signing (any non-empty string)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# MySQL connection string (required for full functionality)
# Example: mysql://user:****@localhost:3306/pentest_portal
DATABASE_URL=

# OAuth (required for production login)
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# Optional: First user's OpenID becomes admin
OWNER_OPEN_ID=

# Optional: AI features (Gemini). Set GEMINI_API_KEY for Gemini, or use Forge below.
GEMINI_API_KEY=

# Optional: Custom AI API (overrides GEMINI_API_KEY when both are set)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Dev mode: bypass OAuth, use /api/dev-login to sign in as dev user
# Requires DATABASE_URL. Set both when developing locally without OAuth.
DEV_BYPASS_AUTH=false
VITE_DEV_LOGIN=false

# Admin login: email/password sign-in at /api/admin-login (do not commit .env)
# Set both to enable. Credentials only in .env — never commit.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# CI/CD gate API key for cicd.scan (legacy env fallback; prefer Integrations → CI keys UI)
# CICD_API_KEY=

# n8n operations-security-alerts webhook (scan critical/high/failed → ops channel)
# N8N_WEBHOOK_URL=https://gravitee.app.n8n.cloud/webhook/operations-security-alerts
# N8N_WEBHOOK_TOKEN=

# GitHub repo scanning (SAST/SCA/secrets)
# GITHUB_TOKEN=ghp_...   # private repos / higher rate limits for clone
# SEMGREP_CONFIG=p/owasp-top-ten,p/java,p/javascript,p/typescript,p/secrets
# SEMGREP_EXCLUDE=node_modules,dist,build,target,.git,coverage,vendor
# SAST_CLONE_TIMEOUT_MS=180000
# SAST_SEMGREP_TIMEOUT_MS=600000
# SAST_MAX_FINDINGS=150
# SCA_MANIFEST_DIR=./data/manifests

# Max concurrent scans (default 2)
# SCAN_MAX_CONCURRENT=2

# Optional out-of-band SSRF collaborator
# OOB_CALLBACK_BASE=https://your-id.oast.fun
# Or native Interactsh:
# INTERACTSH_SERVER=https://oast.pro
# INTERACTSH_TOKEN=

# Scanner artifact storage (local dir; optional S3)
# ARTIFACT_DIR=./data/artifacts
# ARTIFACT_S3_BUCKET=
# AWS_REGION=us-east-1
# ARTIFACT_RETENTION_DAYS=30

# Enterprise OIDC SSO (Okta / Azure AD / Keycloak / Auth0)
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://your-portal/api/oidc/callback
# OIDC_SCOPES=openid profile email
